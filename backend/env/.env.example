# 环境变量模板：复制为 .env.dev / .env.prod 后按需修改（实体文件不入库，见 .gitignore 的 **/env/.env.*）
# 加载哪一份由操作系统环境变量 ENVIRONMENT 决定，缺省为 dev：ENVIRONMENT=prod python main.py
# 未创建任何 env 文件时，下列内置默认值生效：SQLite + 本机 Redis(6379, 无密码) + SECRET_KEY=secret

# 服务器
SERVER_HOST=0.0.0.0
SERVER_PORT=8001
DEBUG=True

# JWT：生产环境务必改为强随机值（openssl rand -hex 32）
SECRET_KEY=secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_SECONDS=43200

# 数据库：sqlite | mysql | postgres 三选一，ASYNC_DB_URI 会据此拼接方言连接串
# 切 mysql 时只改上面那一行即可：下面几项已与 compose 自带 MySQL 的默认值对齐（建库、账号都由 compose 完成）
# 用本机已装的 MySQL 才需要改 host / port / user / password，并自己建一个 utf8mb4 库
DATABASE_TYPE=sqlite
DATABASE_HOST=127.0.0.1
DATABASE_PORT=33066
DATABASE_USER=quickadmin
DATABASE_PASSWORD=change_me_app_password
DATABASE_NAME=quickadmin

# Redis：本地开发可直接用 docker compose -f docker/docker-compose.yaml up -d redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB_NAME=1
REDIS_PASSWORD=

# 日志
LOGGER_LEVEL=DEBUG

# 登录验证码
CAPTCHA_ENABLE=False
CAPTCHA_EXPIRE_SECONDS=60
