# ============================================
# QuickAdmin 部署环境变量模板
# 本地开发不必创建这个文件：compose 每项都有默认值，直接 up -d 即可
# 用法：部署时复制为 .env 并把下面的占位密码改为随机值——deploy.sh 会拦住沿用占位值的 .env
#   cp .env.example .env
# ============================================

# ---------- MySQL ----------
# 应用账号，不要填 root（root 由 MYSQL_ROOT_PASSWORD 单独管理）
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=quickadmin
MYSQL_USER=quickadmin
MYSQL_PASSWORD=change_me_app_password
# 宿主机映射端口（容器内恒为 3306）
# 故意不用 3306：本机已装 MySQL 时端口会直接撞车，容器起不来
MYSQL_PORT=33066

# ---------- Redis ----------
# 本地开发留空即可。设了密码后，本地跑的后端也要在 backend/env/.env.dev 里写同名的 REDIS_PASSWORD（容器化的后端会自动继承这里的值），否则报 Authentication required
REDIS_PASSWORD=
REDIS_PORT=6379

# ---------- 后端 ----------
# JWT 签名密钥，务必改为强随机值：openssl rand -hex 32
SECRET_KEY=change_me_to_a_random_64char_secret
# 运行环境，对应 backend/env/.env.{DEPLOY_ENV}
DEPLOY_ENV=prod
BACKEND_PORT=8001
BACKEND_IMAGE_TAG=0.1.0
LOGGER_LEVEL=INFO

# ---------- 网关 ----------
HTTP_PORT=80
HTTPS_PORT=443
