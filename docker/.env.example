# ============================================
# QuickAdmin 部署环境变量模板
# 用法：复制为 .env 并填写真实值——deploy.sh 缺失 .env 时会自动复制本文件并中止
#   cp .env.example .env
# ============================================

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=quickadmin
MYSQL_USER=quickadmin
MYSQL_PASSWORD=change_me_app_password
# 宿主机映射端口（容器内恒为 3306）
# 故意不用 3306：本机已装 MySQL 时端口会直接撞车，容器起不来
MYSQL_PORT=33066

# ---------- Redis ----------
# 本地开发留空即可；一旦设了密码，必须同时在 backend/env/.env.dev 里写同名的 REDIS_PASSWORD，否则后端报
# redis.exceptions.AuthenticationError: Authentication required.
REDIS_PASSWORD=
REDIS_PORT=6379

# ---------- 后端 ----------
# JWT 签名密钥，务必改为强随机值：openssl rand -hex 32
SECRET_KEY=change_me_to_a_random_64char_secret
# 运行环境，对应 backend/env/.env.{DEPLOY_ENV}
DEPLOY_ENV=prod
BACKEND_PORT=8001
BACKEND_IMAGE_TAG=0.1.0
LOGGER_LEVEL=INFO

# ---------- 网关 ----------
HTTP_PORT=80
HTTPS_PORT=443
