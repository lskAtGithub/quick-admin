# 生产环境配置

VITE_APP_ENV = production

VITE_APP_TITLE = QuickAdmin

# 浏览器侧同源前缀：生产由 nginx 将 /api/v1 反代到后端，无需 Vite 代理
VITE_API_URL = /

# axios baseURL（不含 VITE_API_BASE_URL，避免携带开发代理逻辑）
VITE_APP_BASE_API = /api/v1

# 请求超时（毫秒）
VITE_API_TIMEOUT = 15000

# 部署基础路径，需与 nginx 的 /web 及前端资源路径一致
VITE_BASE_URL = /web/

# 锁屏密码加密密钥（仅用于本地锁屏，非安全敏感）
VITE_LOCK_ENCRYPT_KEY = quick-admin-lock-key-2026
