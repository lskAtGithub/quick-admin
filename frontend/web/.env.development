# 开发环境配置

VITE_APP_ENV = dev

VITE_APP_TITLE = QuickAdmin

# 浏览器侧同源前缀（配合 Vite 代理，请求走本地端口 + 代理转发到后端）
VITE_API_URL = /

# 代理目标：本机后端
VITE_API_BASE_URL = http://127.0.0.1:8001

# axios baseURL / 代理匹配前缀
VITE_APP_BASE_API = /api/v1

# 请求超时（毫秒）
VITE_API_TIMEOUT = 15000

# 开发端口
VITE_PORT = 5173

# 部署基础路径
VITE_BASE_URL = /

# 锁屏密码加密密钥（仅用于本地锁屏，非安全敏感）
VITE_LOCK_ENCRYPT_KEY = quick-admin-lock-key-2026

